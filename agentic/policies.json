{
  "protected_paths": [
    ".git/*",
    ".github/*",
    "*.pem",
    "*.key",
    ".env",
    ".env.*",
    "secrets/*"
  ],
  "dependency_allowlist": [
    "starlette",
    "uvicorn",
    "pydantic",
    "httpx",
    "pytest",
    "Microsoft.Data.Sqlite",
    "Microsoft.AspNetCore.Mvc.Testing",
    "Microsoft.NET.Test.Sdk",
    "xunit",
    "xunit.runner.visualstudio"
  ],
  "dependency_denylist": [
    "pickle5",
    "requests-toolbelt-insecure",
    "pyyaml<5.4",
    "System.Runtime.Serialization.Formatters"
  ],
  "max_lines_changed_without_approval": 400,
  "min_tests": 5,
  "require_release_approval": true
}
